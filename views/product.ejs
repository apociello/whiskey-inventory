<!DOCTYPE html>
<html lang="en">
<%- include('./partials/head.ejs') %>

<body>
    <a href="/inventory/" >Back</a>

    <div class="form-wrapper">
        <h1>Edit Whiskey</h1>

        <form action="" class="whiskey-form" autocomplete="off">

            <label for="category">Category</label>
            <select id="category" name="category" required>
                <option value="Scotch" <%= whiskey.category_name === 'Scotch' ? 'selected' : '' %>>Scotch</option>
                <option value="Bourbon" <%= whiskey.category_name === 'Bourbon' ? 'selected' : '' %>>Bourbon</option>
                <option value="Irish" <%= whiskey.category_name === 'Irish' ? 'selected' : '' %>>Irish</option>
                <option value="Japanese" <%= whiskey.category_name === 'Japanese' ? 'selected' : '' %>>Japanese</option>
                <option value="Tennessee" <%= whiskey.category_name === 'Tennessee' ? 'selected' : '' %>>Tennessee</option>
            </select>

            <label for="whiskey_name">Whiskey</label>
            <input id="whiskey_name" type="text" name="whiskey_name" value="<%= whiskey.whiskey_name %>" minlength="1" maxlength="50"  required>

            <label for="age">Age</label>
            <div class="double-input">
                <input id="age" name="age" type="number" min="1" max="100" <%= whiskey.age == null ? 'disabled' : 'required' %>
                value="<%= whiskey.age ?? '' %>">
                <div class="check-div">
                    <input type="checkbox" id="age_toggle" <%= whiskey.age != null ? 'checked' : '' %>>
                </div>  
            </div>
            
            <label for="price">Price</label>
            <input id="price" type="number" step="0.01" min="1" max="100000" name="price" value="<%= whiskey.price %>" required>

            <label for="stock">Stock</label>
            <input id="stock" type="number" min="0" max="10000" name="stock" value="<%= whiskey.stock %>" required>

            <button type="submit">Edit</button>
            <button type="button">Delete</button>
        </form>
    </div>

    <script src="/js/whiskey_form.js"></script>
</body>
</html>