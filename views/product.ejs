<!DOCTYPE html>
<html lang="en">
<%- include('./partials/head.ejs') %>

<body>
    <a href="/inventory/" >Back</a>

    <div class="form-wrapper">
        <h1>Edit Whiskey</h1>

        <form action="" class="whiskey-form" autocomplete="off">

            <label for="category">Category</label>
            <select id="category" name="category" required>
                <option value="Scotch" <%= whiskey.category_name === 'Scotch' ? 'selected' : '' %>>Scotch</option>
                <option value="Bourbon" <%= whiskey.category_name === 'Bourbon' ? 'selected' : '' %>>Bourbon</option>
                <option value="Irish" <%= whiskey.category_name === 'Irish' ? 'selected' : '' %>>Irish</option>
                <option value="Japanese" <%= whiskey.category_name === 'Japanese' ? 'selected' : '' %>>Japanese</option>
                <option value="Tennessee" <%= whiskey.category_name === 'Tennessee' ? 'selected' : '' %>>Tennessee</option>
            </select>

            <label for="whiskey_name">Whiskey</label>
            <input id="whiskey_name" type="text" name="whiskey_name" value="<%= whiskey.whiskey_name %>" required>

            <label for="age">Age</label>
            <input id="age" name="age"
            type="<%= whiskey.age == null ? 'text' : 'number' %>"
            min="<%= whiskey.age == null ? '' : '1' %>"
            <%= whiskey.age == null ? 'disabled' : '' %>
            value="<%= whiskey.age ?? '-' %>"
            required>
            
            <label for="price">Price</label>
            <input id="price" type="number" step="0.01" min="0" name="price" value="<%= whiskey.price %>" required>

            <label for="stock">Stock</label>
            <input id="stock" type="number" min="0" name="stock" value="<%= whiskey.stock %>" required>

            <button type="submit">Edit</button>
            <button type="button">Delete</button>
        </form>
    </div>
</body>
</html>