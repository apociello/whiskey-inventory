<!DOCTYPE html>
<html lang="en">
<%- include('./partials/head.ejs') %>

<body>
    <a href="/inventory/" >Back</a>

    <div class="form-wrapper">
        <h1>Edit Whiskey</h1>

        <form method="POST" action="" class="whiskey-form" autocomplete="off" novalidate>

            <label for="category">Category</label>
            <select id="category" name="category" required>
                <option value="Scotch" <%= (locals.formData?.category ?? whiskey.category_name) === 'Scotch' ? 'selected' : '' %>>Scotch</option>
                <option value="Bourbon" <%= (locals.formData?.category ?? whiskey.category_name) === 'Bourbon' ? 'selected' : '' %>>Bourbon</option>
                <option value="Irish" <%= (locals.formData?.category ?? whiskey.category_name) === 'Irish' ? 'selected' : '' %>>Irish</option>
                <option value="Japanese" <%= (locals.formData?.category ?? whiskey.category_name) === 'Japanese' ? 'selected' : '' %>>Japanese</option>
                <option value="Tennessee" <%= (locals.formData?.category ?? whiskey.category_name) === 'Tennessee' ? 'selected' : '' %>>Tennessee</option>
            </select>

            <label for="whiskey_name">Whiskey</label>
            <input id="whiskey_name" type="text" name="whiskey_name" value="<%= locals.formData?.whiskey_name ?? whiskey.whiskey_name %>" minlength="1" maxlength="50" required>

            <label for="age">Age</label>
            <div class="double-input">
                <input id="age" name="age" type="number" min="1" max="100"
                    <%= (locals.formData?.age ?? whiskey.age) == null ? 'disabled' : 'required' %>
                    value="<%= locals.formData?.age ?? whiskey.age ?? '' %>">
                <div class="check-div">
                    <input type="checkbox" id="age_toggle" <%= (locals.formData?.age ?? whiskey.age) != null ? 'checked' : '' %>>
                </div>  
            </div>
            
            <label for="price">Price</label>
            <input id="price" type="number" step="0.01" min="1" max="100000" name="price" value="<%= locals.formData?.price ?? whiskey.price %>" required>

            <label for="stock">Stock</label>
            <input id="stock" type="number" min="0" max="10000" name="stock" value="<%= locals.formData?.stock ?? whiskey.stock %>" required>
            
            <label for="password">Password</label>
            <input type="password" id="password" name="password"  value="<%= locals.formData?.password ?? '' %>" required>

            <div class="buttons-div" style="display: flex; gap: 0.5rem;">
                <button type="submit" formaction="/inventory/<%= whiskey.whiskey_id %>/edit">
                    Edit
                </button>

                <button type="submit" formaction="/inventory/<%= whiskey.whiskey_id %>/delete">
                    Delete
                </button>
            </div>
        </form>

        <% if (locals.errors && errors.length > 0) { %>
        <ul class="form-errors">
            <% errors.forEach(err => { %>
            <li><%= err.msg %></li>
            <% }) %>
        </ul>
        <% } %>
    </div>

    <script src="/js/whiskey_form.js"></script>
</body>
</html>