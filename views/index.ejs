<%- include('./partials/head.ejs') %>

<div class="inventory-controls"> 
    <form action="/inventory" method="GET" class="left">
        <input type="text" name="search" value="<%= locals.search || '' %>" placeholder="Search...">

        <select name="category">
            <option value="">All categories</option>
            <option value="Scotch" <%= category === 'Scotch' ? 'selected' : '' %>>Scotch</option>
            <option value="Bourbon" <%= category === 'Bourbon' ? 'selected' : '' %>>Bourbon</option>
            <option value="Irish" <%= category === 'Irish' ? 'selected' : '' %>>Irish</option>
            <option value="Japanese" <%= category === 'Japanese' ? 'selected' : '' %>>Japanese</option>
            <option value="Tennessee" <%= category === 'Tennessee' ? 'selected' : '' %>>Tennessee</option>
        </select>

       <select name="sort">
            <option value="">Sort by...</option>
            <option value="name" <%= sort === 'name' ? 'selected' : '' %>>Name</option>
            <option value="price" <%= sort === 'price' ? 'selected' : '' %>>Price</option>
            <option value="stock" <%= sort === 'stock' ? 'selected' : '' %>>Stock</option>
        </select>

        <select name="order">
            <option value="">Order...</option>
            <option value="asc" <%= order === 'asc' ? 'selected' : '' %>>Ascending</option>
            <option value="desc" <%= order === 'desc' ? 'selected' : '' %>>Descending</option>
        </select>

        <button type="submit">Search</button>
    </form>
    
    <div class="right">
        <button type="button">Add Whisky</button>
    </div>
</div>

<% if (whiskeys.length > 0) { %>

    <table>
        <thead>
            <tr>
                <th>Whiskey</th>
                <th>Category</th>
                <th>Age</th>
                <th>Price</th>
                <th>Stock</th>
            </tr>
        </thead>

        <tbody>
            <% whiskeys.forEach((whiskey) => { %>
                <tr>
                    <td>
                        <a href="/inventory/<%= whiskey.whiskey_id %>">
                            <%= whiskey.whiskey_name %>
                        </a>
                    </td>
                    <td><%= whiskey.category_name %></td>
                    <td><%= whiskey.age ?? '-' %></td>
                    <td>$<%= whiskey.price %></td>
                    <td><%= whiskey.stock %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>

<% } else { %>
    <p>No whiskeys</p>
<% } %>